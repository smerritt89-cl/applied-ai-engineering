---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TestRunner from '../../components/assess/TestRunner';
import { prepareQuestions } from '../../lib/questions';
import { getProgram, studioLabel } from '../../lib/program';
import { url } from '../../lib/paths';

export async function getStaticPaths() {
  const exams = await getCollection('exams');
  return exams.map((e) => ({ params: { id: e.data.id }, props: { exam: e } }));
}
const { exam } = Astro.props;
const questions = await prepareQuestions(exam.data.questions);
const b = (await getProgram()).find((x) => x.studio.data.id === exam.data.studio)!;
---

<Base title={exam.data.title}>
  <div class="prose" style="max-width:820px">
    <div class="eyebrow"><a href={url(`/studios/${b.studio.data.id}/`)}>{studioLabel(b.studio.data)}</a> · Studio exam</div>
    <h1>{exam.data.title}</h1>
    <p class="muted">
      Mixes concepts with applied scenarios from every week of the studio. Worth 30% of the studio grade, and you need {Math.round(exam.data.passing * 100)}%
      to complete the studio. Take it closed-book, as you would in a real program: the point is to find out what you know without looking it up.
    </p>
    <TestRunner
      client:load
      kind="exams"
      id={exam.data.id}
      title={exam.data.title}
      questions={questions}
      draw={exam.data.draw}
      timeLimitMinutes={exam.data.timeLimitMinutes}
      passing={exam.data.passing}
    />
    {b.project && <p style="margin-top:24px"><a href={url(`/projects/${b.project.data.id}/`)}>Studio project: {b.project.data.title} →</a></p>}
  </div>
</Base>
