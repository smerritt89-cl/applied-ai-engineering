{
  "name": "applied-ai-engineering",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-credits.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "audio": "astro build && scripts/tts/.venv/bin/python scripts/tts/generate.py && astro build",
    "audio:setup": "python3 -m venv scripts/tts/.venv && scripts/tts/.venv/bin/pip install -r scripts/tts/requirements.txt",
    "credits": "node scripts/build-credits.mjs",
    "check:videos": "node scripts/check-videos.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run check:videos && npm run check:links && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.5",
    "@astrojs/preact": "^6.1.5",
    "astro": "^7.4.11",
    "mermaid": "^12.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
