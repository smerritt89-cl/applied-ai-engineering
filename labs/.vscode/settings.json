{
  // Opened by the "Open in VS Code" buttons on lab links. Makes the labs
  // folder ready to use: the lab Python environment, tests in the Testing
  // panel, and Markdown (READMEs, walkthroughs) opening as formatted pages.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["."],
  "workbench.editorAssociations": { "*.md": "vscode.markdown.preview.editor" },
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true },
  "editor.rulers": [100]
}
